# Copy to .env and fill in (do not commit .env)

# Optional — defaults to /api (Vite proxy in dev, Nginx on VPS).
# Do NOT set to http://your-server:3001 in production; port 3001 is not public.
# VITE_API_URL=/api

# iOS PWA phone testing: run `npm run dev:https` (self-signed cert on port 3000).
# On iPhone Safari open https://<your-pc-lan-ip>:3000, trust the cert, then Add to Home Screen.
