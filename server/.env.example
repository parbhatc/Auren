# Copy to server/.env and fill in (do not commit server/.env)

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Rithmic: log every send/recv on all gateway clients (very noisy — chart, MDS, history)
# RITHMIC_WIRE_DEBUG=1

# Rithmic chart: history summary + live quote/trade/bar (like rithmic-api live-chart.js)
# RITHMIC_CHART_DEBUG=1

# Rithmic /accounts: one compact trace block per request (recommended for debugging)
# RITHMIC_ACCOUNTS_LOG=1
# Add full JSON bodies under that block (very noisy)
# RITHMIC_ACCOUNTS_LOG_VERBOSE=1
# Include packet trace in API JSON (?debug=1) — does not add console spam
# RITHMIC_ACCOUNTS_DEBUG=1

# Required in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret
