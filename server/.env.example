# Copy to server/.env and fill in (do not commit server/.env)

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Required in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# TradingView sessionid cookie used by practice market data and CSV downloads.
TRADINGVIEW_SESSION_ID=
# Practice market-data streaming can still use the optional gateway.
TRADINGVIEW_GATEWAY_WS_URL=ws://127.0.0.1:8532/api/tradingview/stream
TRADINGVIEW_REQUEST_TIMEOUT_MS=20000
TRADINGVIEW_MAX_BARS=5000
TRADINGVIEW_LIVE_POLL_MS=5000
