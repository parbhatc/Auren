# Copy to server/.env and fill in (do not commit server/.env)

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Required in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Server-side credential used only by the practice market-data stream.
TRADINGVIEW_AUTH_TOKEN=
TRADINGVIEW_REQUEST_TIMEOUT_MS=20000
TRADINGVIEW_MAX_BARS=5000
TRADINGVIEW_LIVE_POLL_MS=5000
