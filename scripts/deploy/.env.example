# Copy to scripts/deploy/.env (gitignored) and fill in.
# Used by: npm run deploy:<command>

# SSH target
DEPLOY_HOST=74.208.46.161
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASSWORD=

# App on the server
INSTALL_DIR=/root/Auren
REPO_URL=https://github.com/parbhatc/Auren.git
GIT_BRANCH=main

# Public URL (CORS + HTTPS cert hint)
PUBLIC_URL=https://aurens.app

# Apex domain for nginx server_name and Let's Encrypt (omit www — both apex + www are configured)
APP_DOMAIN=aurens.app

# API port behind nginx (do not expose publicly if nginx proxies)
API_PORT=3001

# Backups of server/data before install/update (on the server)
BACKUP_DIR=/root/auren-backups
